# SHILP-AI Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to GitHub!

# ─── Supabase (Primary Backend) ────────────────────────────────────────────────
# Get these from: https://supabase.com → Project → Settings → API
VITE_SUPABASE_URL=https://bzcddvkndxfxskziezml.supabase.co
VITE_SUPABASE_ANON_KEY= sb_publishable_XY0ynHHxUeeJacRPmAVvTw_4nobMu56

# ─── Google Gemini API ─────────────────────────────────────────────────────────
# Get your free key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── Firebase (Legacy — kept for backward compat, optional) ───────────────────
